# このファイルを `mise.local.toml` にコピーして値を埋める。
# `mise.local.toml` は gitignore 済み(コミットされない)。
#
#   cp mise.local.toml.example mise.local.toml
#
# [env] に SECRET_ で始まる変数を書くと、コンパイル時に
# arduino_secrets.h の #define として各スケッチに注入される。
# 例: SECRET_SSID -> #define SECRET_SSID "..."

[env]
SECRET_SSID = "your-wifi-ssid"
SECRET_PASS = "your-wifi-password"

# backlog_user スケッチ用。Backlog の FQDN と個人 API キー。
# API キーは Backlog の「個人設定 > API」で発行する。
SECRET_BACKLOG_HOST = "your-space.backlog.com"
SECRET_BACKLOG_APIKEY = "your-backlog-api-key"

# morse_gemini スケッチ用。Google Gemini API キー。
# Google AI Studio (https://aistudio.google.com/) で発行する。
SECRET_GEMINI_APIKEY = "your-gemini-api-key"
